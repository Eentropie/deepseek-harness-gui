{
  "name": "deepseek-harness-workbench",
  "productName": "DeepSeek Harness",
  "description": "Standalone macOS and Windows desktop client for a local DeepSeek Harness Host.",
  "author": "Local Harness",
  "private": false,
  "version": "0.3.1",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build:renderer": "vite build",
    "build:desktop": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --format=cjs --target=node22 --external:electron --outdir=dist-electron --out-extension:.js=.cjs",
    "build": "tsc --noEmit && pnpm build:renderer && pnpm build:desktop",
    "desktop": "node scripts/launch-branded-desktop.mjs",
    "desktop:dev": "pnpm build && electron .",
    "pack:mac": "pnpm build && electron-builder --mac dir --arm64",
    "dist:mac": "pnpm build && electron-builder --mac dmg zip --arm64 --publish never",
    "pack:win": "pnpm build && electron-builder --win dir --x64",
    "dist:win": "pnpm build && electron-builder --win nsis --x64 --publish never",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@lobehub/icons-static-svg": "^1.94.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "typescript": "6.0.3",
    "vite": "6.4.3",
    "vitest": "4.1.8"
  },
  "engines": {
    "node": ">=22"
  },
  "build": {
    "appId": "ai.deepseek.harness.workbench",
    "productName": "DeepSeek Harness",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.icns",
      "build/icon.ico",
      "build/icon.png",
      "package.json"
    ],
    "protocols": [
      {
        "name": "DeepSeek Harness session",
        "schemes": [
          "dsh-workbench"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "artifactName": "DeepSeek-Harness-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "DeepSeek-Harness-${version}-Windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DeepSeek Harness",
      "uninstallDisplayName": "DeepSeek Harness"
    }
  },
  "packageManager": "pnpm@11.7.0"
}
